{
  "name": "lavateinn",
  "private": true,
  "version": "1.0.0",
  "description": "Tiny and flexible microservice framework for fast development.",
  "author": "Star Inc.",
  "homepage": "https://github.com/star-inc/lavateinn",
  "repository": "https://github.com/star-inc/lavateinn",
  "license": "BSD-3-Clause",
  "main": "app.ts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch app.ts",
    "start": "node app.ts",
    "lint": "npx lint-staged",
    "lint:ts": "tsc --noEmit",
    "lint:es": "eslint .",
    "lint:es:fix": "eslint . --fix",
    "test": "mocha test --exit --recursive --timeout 5000",
    "cover": "nyc mocha test --recursive --timeout 5000 --exit",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.ts": "eslint"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "amqplib": "^0.10.5",
    "dotenv": "^16.0.3",
    "got": "^14.4.4",
    "hono": "^4.6.0",
    "http-status-codes": "^2.2.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.8",
    "node-schedule": "^2.1.1",
    "rimraf": "^5.0.7",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@eslint/js": "^9.39.4",
    "@types/amqplib": "^0.10.8",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/node-schedule": "^2.1.8",
    "@types/supertest": "^6.0.3",
    "chai": "^5.1.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-mocha": "^10.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^16.1.2",
    "mocha": "^11.0.1",
    "nodemon": "^3.1.10",
    "nyc": "^17.1.0",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
